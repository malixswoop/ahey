<!doctype html>
<html lang="en">
	<%- include('partials/html-head'); -%>
	<body onload="App.getDevice()">
		<div id="app" class="wrap">
			<%- include('partials/header'); -%>
			<h1 class="page-title flex-1">Channels</h1>
			<p>List of all the channels subscribed from this browser / device.</p>

			<section>
				<div v-for="(channel, i) in channels" v-bind:key="channel" class="item">
					<div class="row">
						<a v-bind:href="'/'+channel" class="title" rel="noopener noreferrer">/{{channel}}</a>
						<span class="meta light">
							<span> &middot; </span>
							<a href="javascript:void(0)" v-on:click="unsubscribeChannel(channel)" class="red">Unsubscribe</a>
						</span>
					</div>
				</div>
				<p v-if="channels.length === 0 && !isLoading" class="empty">You are not subscribed to any channels</p>
				<div v-if="isLoading" class="loader"></div>
			</section>

			<section class="flex">
				<input
					type="text"
					id="channelBox"
					v-model="channelName"
					placeholder="Channel name"
					v-on:keyup.enter="subscribeChannel(channelName)"
				/>

				<a href="javascript:void(0)" v-on:click="subscribeChannel(channelName)" v-if="channelName.length > 0">
					Subscribe
				</a>
			</section>

			<%- include('partials/footer'); -%>
		</div>
	</body>
</html>
