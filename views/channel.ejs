<!doctype html>
<html lang="en">
	<%- include('partials/html-head'); -%>
	<body onload="App.pull('<%=channel%>')">
		<div id="app" class="wrap" v-cloak>
			<%- include('partials/header'); -%>
			<h1 class="page-title flex-1"><% if(!channel.startsWith("@")) { %>#<%}%><%=channel%></h1>
			<div class="small light">
				<span>{{channelSubscribersCount}} subscriber{{channelSubscribersCount === 1 ? '' : 's'}}</span>
				<span class="separator">&middot;</span>

				<a
					href="javascript:void(0)"
					v-on:click="subscribeChannel('<%=channel%>')"
					v-if="!channels.includes('<%=channel%>')"
					>Subscribe</a
				>
				<a
					href="javascript:void(0)"
					v-on:click="unsubscribeChannel('<%=channel%>')"
					v-if="channels.includes('<%=channel%>')"
					class="red"
					>Unsubscribe</a
				>
			</div>

			<section>
				<input
					type="text"
					id="pushBox"
					v-model="pushBody"
					placeholder="Push something to this channel"
					v-on:keyup.enter="push('<%=channel%>', pushBody)"
				/>
				<button v-on:click="push('<%=channel%>', pushBody)" v-bind:disabled="isSaving" v-if="pushBody.length > 0">
					Push
				</button>
			</section>
			<section>
				<div v-for="(push, i) in pushes" v-bind:key="push._id" class="item">
					<div class="row">
						<div class="small">
							<a :href="'/@'+push.from.username">@{{push.from.username}}</a>
							<span> &middot; </span>
							<span>{{displayDate(push.date)}}</span>
						</div>
						<div class="large" v-html="linkify(push.body)"></div>
					</div>
				</div>
				<div v-if="isLoading" class="loader"></div>
			</section>
			<%- include('partials/footer'); -%>
		</div>
	</body>
</html>
